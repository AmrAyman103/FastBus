  @model FastBusMVC.ViewModel.RegisterUserViewModel
 
@{
    Layout = null;
}
<link href="~/css/registr.css" rel="stylesheet" />
<section class="container">
      <header>Registration Form</header>
      <form masp-controller="Account" asp-action="register" method="post" class="form" enctype="multipart/form-data">

        <div class="input-box">
          <label>First Name</label>
          <input asp-for="FirstName" placeholder="Enter First name" required />
          <span style="color:red;" asp-validation-for="FirstName" class="text-danger"></span>
                  
        </div>

        <div class="input-box">
          <label>Last Name</label>
          <input asp-for="LastName" placeholder="Enter Last name" required />
          <span style="color:red;" asp-validation-for="LastName" class="text-danger"></span>
      
        </div>

        <div class="input-box">
          <label>User Name</label>
          <input asp-for="UserName" placeholder="Enter username" required />
          <span style="color:red;" asp-validation-for="UserName" class="text-danger"></span>
      </div>

        <div class="input-box">
          <label>Email Address</label>
          <input asp-for="Email" placeholder="Enter Email" required />
           <span style="color:red;" asp-validation-for="Email" class="text-danger"></span>

      </div>

        <div class="input-box">
          <input asp-for="Password" placeholder="Enter Password" required />
           <span style="color:red;" asp-validation-for="Password" class="text-danger"></span>

        </div>


        <div class="column">
          <div class="input-box">
            <label>Phone Number</label>
            <input asp-for="PhoneNumber" placeholder=" Enter Phone number" required />
             <span style="color:red;" asp-validation-for="PhoneNumber" class="text-danger"></span>

          </div>


          <div class="input-box">
            <label>Birth Date</label>
            <input asp-for="DateOfBirth" placeholder=" Enter Birth Date" required />
            <span style="color:red;" asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>
        </div>


        <div class="gender-box">
          <h3>Gender</h3>
          <div class="gender-option">
            <div class="gender">
              <input type="radio" id="male" name="Gender" value="m" required class="gender-input" />
              <label for="check-male">male</label>
            </div>

            <div class="gender">
              <input type="radio" id="female" name="Gender" value="f" required class="gender-input" />
              <label for="check-female">Female</label>
            </div>

          </div>
        </div>

        <div class="input-box address">
          <label>Address</label>
          <input asp-for="Address" placeholder="Enter your address" required />
          <span style="color:red;" asp-validation-for="Address" class="text-danger"></span>
      
          
           
          </div>

        <div class="input_box">
            <i class="uil uil-image" style="float: left; margin-right: 5px;"></i>
            <input asp-for="image" placeholder="Choose image" name="image" accept="image/jpg,image/jpeg,image/png" />
            <span style="color:red;" asp-validation-for="image" class="text-danger"></span>
        </div>
      
        <button type="submit" class="button">Signup Now</button>
     </form>
    </section>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial"></partial>
