 @model FastBusMVC.ViewModel.LoginUserViewModel
@{
    Layout = null;
}
<link href="~/css/loginstyle.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
<div class="wrapper">
    <header>Login Form</header>
    <form asp-controller="Account" asp-action="login" method="post">
        <div asp-validation-summary="All" style="color:red;"></div>
        <div class="field Username">
            <div class="input-area">
                <input asp-for="UserName" placeholder="Enter username" required />
                <span style="color:red;" asp-validation-for="UserName" class="text-danger"></span>

                <i class="icon fas fa-envelope"></i>
                <i class="error error-icon fas fa-exclamation-circle"></i>
            </div>
            <div class="error error-txt">Username can't be blank</div>
        </div>
        <div class="field password">
            <div class="input-area">
                <input asp-for="Password" placeholder="Enter Password" required />
                <span style="color:red;" asp-validation-for="Password" class="text-danger"></span>

                <i class="icon fas fa-lock"></i>
                <i class="error error-icon fas fa-exclamation-circle"></i>
            </div>
            <div class="error error-txt">Password can't be blank</div>
        </div>

        <div class="pass-txt"><a href="#">Forgot password?</a></div>
        <input type="submit" value="Login">
    </form>
    <div class="sign-txt">Not yet member? <a href="/Account/register" id="signup">Signup now</a></div>
</div>
<script src="~/js/loginscript.js"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial"></partial>
  
