<h1>Travel Interfaces</h1>
<br>


@foreach (var trip in Model.Trips)
{
    <div class="container">
        <div class="con">
            <div>
                <a href="@Url.Action("BookingTrip", "Booking")">
                    <img src="~/images/trip/@(trip.TripImage).jpg" width="300" height="350" alt="Trip Image">
                    <div class="cc">
                        <pre>
        Departure City: @trip.DeparureCity
        Arrival City: @trip.ArrivalCity
              Departure Time: @trip.DeparureDataTime
        Price Time: @trip.Price
                                </pre>
                        <a href="@Url.Action("BookingTrip", "Booking")">  <button>Book Now</button></a>
                    </div>
                </a>
            </div>
        </div>
    </div>
}


